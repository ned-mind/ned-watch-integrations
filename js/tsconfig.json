{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": false,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/esm",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../.tools/node_modules/@types"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
