{
  "name": "@nedwatch/ned-watch",
  "version": "0.1.1",
  "description": "Know when your agent silently stops. Deadman check-ins and run timeouts for AI agents, cron jobs and pipelines, on Ned Watch. Zero dependencies.",
  "license": "MIT",
  "author": "Ned Watch <ned@ned.watch>",
  "homepage": "https://ned.watch/integrations/js",
  "keywords": [
    "monitoring",
    "heartbeat",
    "deadman",
    "cron",
    "agents",
    "uptime",
    "dead-man-switch",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nedwatch": "dist/esm/cli.js",
    "ned-watch": "dist/esm/cli.js",
    "ned-run": "dist/esm/ned-run.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "prepublishOnly": "node build.mjs && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ned-mind/ned-watch-integrations.git",
    "directory": "js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
